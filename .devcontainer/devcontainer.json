{
  "name": "Jekyll",
  "image": "mcr.microsoft.com/devcontainers/jekyll:2-3.3-bookworm",
  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": { "label": "Personal website" },
    "35729": { "label": "Jekyll LiveReload", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bundle config set --local path vendor/bundle && bundle install"
}
